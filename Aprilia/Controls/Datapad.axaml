<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:interfaces="clr-namespace:Aprilia.Engines.Glance"
             xmlns:controls="clr-namespace:Aprilia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Aprilia.Controls.Datapad"
             x:DataType="interfaces:IGlanceContent">
    <!--<Grid Opacity="{Binding PageOpacity}" IsVisible="{Binding IsActivePage}">-->
    <Grid Opacity="{Binding PageOpacity}">
        <Grid.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut"/>
            </Transitions>
        </Grid.Transitions>

        <!-- THE RESPONSIVE PERCENTAGE GRID -->
        <Grid ColumnDefinitions="3*, 6.8*, 0.2*" RowDefinitions="0.2*, 9.6*, 0.2*">
            
            <!-- The Datapad sits in the middle cell (Row 1, Column 1) -->
            <Border Grid.Row="1" Grid.Column="1"
                    BorderBrush="{DynamicResource CVGradient}" 
                    Background="{DynamicResource CVGradientTransparent} "
                    BorderThickness="3" 
                    CornerRadius="15"
                    Padding="10"
                    BoxShadow="0 0 20 5 #44FF69B4">
                
                <!-- that function doesnt let scrolling pages if we arent 
                at top or bottom of the scrollviewer. ScrollChanged="OnScrollChanged"-->
                <!--<ScrollViewer x:Name="PageScrollViewer" ScrollChanged="OnScrollChanged"> -->
                <!-- <ScrollViewer x:Name="PageScrollViewer" IsScrollInertiaEnabled="False" > -->
                <ScrollViewer x:Name="PageScrollViewer" 
                              ScrollChanged="OnScrollChanged" 
                              SizeChanged="OnSizeChanged"
                              IsScrollChainingEnabled="False" >
                    <ContentPresenter Content="{Binding InnerContent, RelativeSource={RelativeSource AncestorType=controls:Datapad}}" /> 
                </ScrollViewer>
                
            </Border>
        </Grid>
    </Grid>
</UserControl>
