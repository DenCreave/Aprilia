<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aprilia.ViewModels"
             xmlns:views="clr-namespace:Aprilia.Views"
             x:Class="Aprilia.Views.MainView"
             x:DataType="vm:MainViewModel">
             
    <!-- The Grid forces its children to stretch to 100% of the screen -->
    <Grid Background="#111111">
        <views:TestRenderer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
    
</UserControl>