<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:content="clr-namespace:Aprilia.Engines.Glance.Content"
             xmlns:controls="clr-namespace:Aprilia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Aprilia.Views.Pages.IntroPageView"
             x:DataType="content:IntroContent">
    
    <controls:Datapad>
        <controls:Datapad.InnerContent>
        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="3*,Auto, 7*"  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Grid.Column="0" ClipToBounds="True" >
                    <Image Source="{Binding CurrentProfileImage}" Stretch="UniformToFill" Tapped="OnImageTapped"/>
                </Border>
                <Border Grid.Column="1" Width="20" Background="Transparent" VerticalAlignment="Stretch" />
                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Left"  Spacing="0">
                    <TextBlock Text="{Binding Name}" FontSize="34"  FontWeight="Bold" />
                    <TextBlock Text="{Binding Profession}" FontSize="24"  FontWeight="DemiBold" />
                    
                    <!-- Spacer -->
                    <Border Height="4" Classes="Breaker" Margin="0,0,0,5" />

                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                        <TextBlock Classes="Icon" Text="{Binding EmailIcon}" />
                        <TextBlock Text="{Binding Email}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                        <TextBlock Classes="Icon" Text="{Binding TelegramIcon}" />
                        <TextBlock Text="{Binding Telegram}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                        <TextBlock Classes="Icon" Text="{Binding LocationIcon}" />
                        <TextBlock Text="{Binding Location}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                        <TextBlock Classes="Icon" Text="{Binding RelocationIcon}" />
                        <TextBlock Text="{Binding Relocation}" />
                    </StackPanel>

                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="5" Classes="Breaker" Margin="0,15"   />
            
            <StackPanel Grid.Row="2" Spacing="20">
                <TextBlock Text="{Binding BriefBoutMe}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding NotaBene}" TextWrapping="Wrap"/>
                
                <Button Classes="CvButton" 
                        Content="Download CV" 
                        HorizontalAlignment="Center"
                        Click="OnDownloadClicked"/>
            </StackPanel>

        </Grid>
            
        </controls:Datapad.InnerContent>
    </controls:Datapad>
</UserControl>
