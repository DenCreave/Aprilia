             xmlns:content="clr-namespace:Aprilia.Engines.Glance.Content"
             xmlns:controls="clr-namespace:Aprilia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Aprilia.Views.Pages.IntroPageView"
