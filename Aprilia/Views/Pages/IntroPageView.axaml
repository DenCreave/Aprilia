                <TextBlock Text="{Binding Headline}" FontSize="48" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" FontSize="48" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" FontSize="48" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" FontSize="48" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Headline}" FontSize="48" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" />
