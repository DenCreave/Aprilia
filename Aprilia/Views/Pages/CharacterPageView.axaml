<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:content="clr-namespace:Aprilia.Engines.Glance.Content"
             xmlns:controls="clr-namespace:Aprilia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Aprilia.Views.Pages.CharacterPageView"
             x:DataType="content:CharacterContent">
    <controls:Datapad>
        <controls:Datapad.InnerContent>
            <StackPanel Spacing="30">
                
                <TextBlock Text="{Binding Title}" FontSize="48" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10" />
                
                <TextBlock Text="{Binding P1_Intro}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding P2_Anime}" TextWrapping="Wrap" />
                
                <Grid RowDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Row="0" Text="{Binding P3_Skydiving}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True">
                        <Image Source="{Binding ThroughTheSky}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                
                
                <TextBlock Text="{Binding P4_Community}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding P5_Outro}" TextWrapping="Wrap" />
                
                <Border Height="3" Background="{DynamicResource BreakColor}" Margin="0,20,0,35" />
            </StackPanel>
        </controls:Datapad.InnerContent>
    </controls:Datapad>
</UserControl>
