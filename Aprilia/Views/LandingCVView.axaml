<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aprilia.ViewModels"
             xmlns:ui="clr-namespace:Aprilia.Engines.SpanningTree.UI"
             xmlns:glance="clr-namespace:Aprilia.Engines.Glance"
             x:Class="Aprilia.Views.LandingCVView"
             x:DataType="vm:LandingCVViewModel">

    <Grid Background="Transparent" PointerWheelChanged="OnPointerWheelChanged" ScrollGesture="OnScrollGesture">
        <!-- Animated bg -->
        <ui:SpanningTreeRenderer STC="{Binding Stc}" STT="{Binding Stt}" />

        <!-- Custom content stacker -->
        <ItemsControl ItemsSource="{Binding ContentLoader.Pages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid /> <!-- Stacks pages on top of each other -->
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
       
        
        <glance:GlanceRenderer />
    </Grid>
</UserControl>