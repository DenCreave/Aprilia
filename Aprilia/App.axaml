<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Aprilia"
             x:Class="Aprilia.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->


    <Application.Resources>
        <LinearGradientBrush x:Key="CVGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF0090" Offset="0.0" />
            <GradientStop Color="#FF6D3D" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CVGradientTransparent" StartPoint="0%,0%" EndPoint="100%,100%" Opacity="0.85">
            <GradientStop Color="#FF0090" Offset="0.0" />
            <GradientStop Color="#FF6D3D" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CVGradientReversed" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF6D3D" Offset="0.0" />
            <GradientStop Color="#FF0090" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CVGradientReversedDarkened" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#e36236" Offset="0.0" />
            <GradientStop Color="#cc0073" Offset="1.0" />
        </LinearGradientBrush>
        
        <SolidColorBrush x:Key="BorderColor" Color="#fbc88a"/>
        <SolidColorBrush x:Key="BreakColor" Color=" #ff734c"/>
        <!--<SolidColorBrush x:Key="DarkPlum" Color=" #1A000B"/>-->
        <SolidColorBrush x:Key="DarkPlum" Color=" #20000c"/>
        
        <FontFamily x:Key="Phosphor">avares://Aprilia/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
        <FontFamily x:Key="ExoFontRegular">avares://Aprilia/Assets/Fonts/Exo2-Regular.ttf#Exo 2</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Border.Breaker">
            <Setter Property="Background" Value="{DynamicResource BreakColor}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        
        
        <Style Selector="Button.CvButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CVGradient}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource CVGradientReversed}"/>
            <!-- <Setter Property="Padding" Value="25,12"/>-->
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Smoothly animates the color changes over 0.3 seconds -->
            
        </Style>
        
        <Style Selector="Button.CvButton TextBlock">
            <Setter Property="TextDecorations" Value="{x:Null}"/>
        </Style>
       


        <!-- WHAT HAPPENS ON HOVER -->
        <Style Selector="Button.CvButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CVGradientReversed}"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkPlum}"/>
            <!--<Setter Property="BorderBrush" Value="{DynamicResource CVGradientReversed}"/>-->
            <!--<Setter Property="Foreground" Value="Cyan"/>-->
        </Style>

        <!-- WHAT HAPPENS ON CLICK -->
        <Style Selector="Button.CvButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <!--<Setter Property="Background" Value="#ff215c"/> Flashes dark pink -->
            <Setter Property="Background" Value="{DynamicResource CVGradientReversedDarkened}"/> <!-- Flashes dark pink -->
            <Setter Property="Foreground" Value="{DynamicResource DarkPlum}"/>
            <!--<Setter Property="BorderBrush" Value="Cyan"/>-->
        </Style>
        
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkPlum}"/>
            <!--<Setter Property="Foreground" Value="Green"/>-->
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="TextBlock.Icon">
            <Setter Property="FontFamily" Value="{StaticResource Phosphor}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkPlum}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- THE CONTACT TEXT STYLE -->
        
    </Application.Styles>
</Application>